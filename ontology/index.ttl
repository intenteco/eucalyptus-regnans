qualia:eucalyptus_regnans a dcat:Dataset ;
    owl:sameAs <did:q42:taxon:eucalyptus_regnans> ;
    dct:title "Eucalyptus regnans F.Muell. (Mountain Ash) Hypermedia Dataset"@en ;
    dct:description "SE Australian tall wet-sclerophyll flora ontology, pipe-model allometry, obligate-seeder fire ecology, InstanceState64 ontogeny, and multi-regime Hypermedia (.hmc) production manifest."@en ;
    dct:publisher <https://github.com/intenteco> ;
    dct:spatial "South-Eastern Australia (Victorian Central Highlands, Yarra Ranges, Dandenongs, Strzeleckis, Otway Ranges; Tasmania Huon, Derwent & North-East)" ;
    dct:license <https://spdx.org/licenses/CC-BY-4.0.html> ;
    q42:commonsFramework "SPC" ;
    dcat:landingPage <https://github.com/intenteco/eucalyptus-regnans> ;
    dct:hasPart member:taxon-ttl ,
                member:taxon-q42 ,
                member:index-ttl ,
                member:index-q42 ,
                member:claims-json ,
                member:bookmarks-json ,
                member:jobs-json ,
                member:planned-vibe-cad ,
                member:planned-actuation-vibe ,
                member:planned-hmc ,
                member:planned-10d ,
                member:planned-substrate-m64 ,
                member:planned-field-emf .

