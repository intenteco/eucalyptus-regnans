rel:working a dcat:Dataset ;
    dct:isVersionOf qualia:eucalyptus_regnans ;
    dct:identifier "working-eco-wp-04a" ;
    rdfs:comment "Single species HMC manifest. Individuals are parameterized by InstanceState64 (seed, ontogenetic_age_norm, height_scale, site_vigor, environmental_stress) plus pipe-model parameters."@en .

ereg:OrganismTemplate a rdfs:Class ;
    rdfs:label "Eucalyptus regnans F.Muell. Organism Template"@en ;
    rdfs:comment "Instantiate individual trees via InstanceState64 across stages {ashbed_sapling: 0.00-0.15, pole_spar: 0.15-0.45, canopy_giant: 0.45-0.80, veteran: 0.80-1.00} with Shinozaki exponent 2.49, fork angles 32-48 deg, mature height 55-95 m (historical >100 m), DBH 2.0-6.5 m, air-dry wood density 650 kg/m3, E=16.0 GPa, P50=-2.9 MPa, SLA=8.4 m2/kg, and obligate-seeder ash-bed fire ecology (lignotuber absent)."@en .
